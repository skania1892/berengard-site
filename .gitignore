# Dependencies — rebuilt from package.json / package-lock.json by `npm install`.
node_modules/

# Build output — regenerated by `npm run build`; Netlify builds its own copy.
dist/

# Local backups of assets before optimization (not part of the site).
.image-backup/

# Secrets — never commit API keys. netlify/functions/ai-chat.js reads its key
# from the environment, which is configured in the Netlify dashboard.
.env
.env.*
!.env.example

# Netlify CLI local state
.netlify/

# Editor / OS cruft
.DS_Store
Thumbs.db
*.local
.vscode/
.idea/

# Logs
npm-debug.log*
yarn-error.log*
